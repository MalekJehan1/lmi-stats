{
  "services": {
    "lmi-stats-web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "pnpm install && pnpm build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "lmi-stats-web"
      }
    }
  ]
}